; repo_euwar_conquest_engine -- authoritative JUDGE project configuration.
; Overlaid last: this file wins over any workspace edit. Lean on purpose --
; only the autoloads the judged conquest layer needs (no theme/font, judging
; is headless and renders nothing).

config_version=5

[application]

config/name="Eu-War-Conquest-Judge"
run/main_scene="res://judge.tscn"
config/features=PackedStringArray("4.4")

[autoload]

DataLoader="*res://scripts/autoload/data_loader.gd"
GameState="*res://scripts/autoload/game_state.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/treat_warnings_as_errors=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
