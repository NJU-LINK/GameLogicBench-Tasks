config_version=5

[application]
config/name="WorldWarII — Battle Doctrine (judge)"
config/description="Tactical hex-battle engagement layer. Judge driver boots the real battle.tscn headless and asserts world-observable combat trajectories against an independent oracle."
run/main_scene="res://judge.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.svg"

[autoload]

AppTheme="*res://scripts/autoload/app_theme.gd"
DataLoader="*res://scripts/autoload/data_loader.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioBank="*res://scripts/autoload/audio_bank.gd"

[gui]

theme/custom_font="res://assets/fonts/NotoSansCJKtc-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
